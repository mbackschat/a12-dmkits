{
  "_about": "Per-verb worked demonstrations — one read-only invocation per verb (a read, or a mutation under --dry-run), surfaced in `manifest` (each verb's `example`) so a cold agent sees the verb IN ACTION, and CI-executed by VerbDemonstrationTest so it cannot rot. `<model.json>`/`<doc.json>` are placeholders the agent fills; the test substitutes a fixture. expect ∈ read|preview|raw. Coverage is enforced by CliConformanceMatrixTest (the has-demonstration column).",

  "model new":           { "intent": "create a new empty kernel-valid model from scratch (no -m needed — it makes one)", "command": ["model", "new", "--id", "orders", "--locale", "en_US", "--root", "Order"], "expect": "raw" },
  "model info":          { "intent": "the model's header dashboard — identity, super/subtypes, and includes/type-def imports resolved to files + compact counts", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "model", "info"], "expect": "read" },
  "model check":         { "intent": "statically check the whole model's definitions against the kernel", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "check"], "expect": "read" },
  "model describe":      { "intent": "read the model structure (fields + kinds, groups) into data", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "describe"], "expect": "read" },
  "model diff":          { "intent": "structural diff of two model files (base then head) — complete field, group, rule, computation, typedef, include/import, and model-configuration changes with per-aspect deltas and review-impact reasons; a pure reformat is never reported (here a model vs itself: an empty diff)", "model": "order-ruled.dm.json", "command": ["model", "diff", "<model.json>", "<model.json>"], "expect": "read" },
  "model read":          { "intent": "read the model card (header + counts) into data", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "read"], "expect": "read" },
  "model usage":         { "intent": "model-wide usage audit — every field's referencing rules/computations + the unreferenced set", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "usage"], "expect": "read" },
  "model report":        { "intent": "comprehension report — identity, a structure outline, the dead-field set, and a glossed rules/computations catalog; add --tree for a flat per-node projection", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "report"], "expect": "read" },
  "model rename":        { "intent": "preview changing the model's header id (single-model; a -w workspace gate refuses if a sibling includes the old id)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "rename", "--to", "purchase-order", "--dry-run"], "expect": "preview" },
  "model normalize":     { "intent": "preview rewriting the model in canonical, deterministic form (formatting only — order preserved, no semantic change) so later edits diff cleanly", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "normalize", "--dry-run"], "expect": "preview" },
  "model eval":          { "intent": "evaluate a filled document instance — which rules fire", "model": "order-ruled.dm.json", "doc": { "fields": { "Order": { "CustomerName": "Acme", "Quantity": "5", "OrderDate": "2026-01-01", "DeliveryDate": "2026-01-10" } } }, "command": ["-m", "<model.json>", "model", "eval", "--instance", "<doc.json>"], "expect": "read" },
  "model compute":       { "intent": "run the model's computations over a filled instance", "model": "order-ruled.dm.json", "doc": { "fields": { "Order": { "Quantity": "5" } } }, "command": ["-m", "<model.json>", "model", "compute", "--instance", "<doc.json>"], "expect": "read" },
  "model seed":          { "intent": "generate a best-effort model-derived sample candidate (JSON) — feed it straight into model eval/compute/rule eval as --instance", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "seed", "--seed", "42"], "expect": "raw" },
  "model import-jsonschema": { "intent": "import a JSON Schema as a kernel-valid model (structure + rules; unmappable features are omitted with a to-do in the stderr report)", "schema": { "title": "Order", "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "quantity": { "type": "integer" } } }, "command": ["model", "import-jsonschema", "--schema", "<schema.json>"], "expect": "raw" },
  "model export-jsonschema": { "intent": "export the model as a JSON Schema (structure native; rules/computations ride x-a12-* carriage)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "model", "export-jsonschema"], "expect": "raw" },
  "profile extract":     { "intent": "reduce a model to its identifier-free structure, program-work, computation, and wiring distributions for performance calibration", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "profile", "extract"], "expect": "read" },
  "profile synthesize":  { "intent": "materialize a deterministic own-domain DM-JSON model from a current performance profile", "model": "order-ruled.dm.json", "command": ["profile", "synthesize", "--input", "<profile.json>", "--seed", "42"], "expect": "raw" },
  "profile compare":     { "intent": "classify every fidelity axis between a target and actual current profile; a mismatch is visible as valid:false and exit 1", "model": "order-ruled.dm.json", "command": ["profile", "compare", "--target", "<profile.json>", "--actual", "<profile.json>"], "expect": "read" },

  "rule check":        { "intent": "validate a candidate rule condition before adding it", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "check", "--field", "/Order/Quantity", "--condition", "[/Order/Quantity] < 0", "--code", "NEGATIVE_QTY"], "expect": "read" },
  "rule read":         { "intent": "read a rule's condition back as DSL", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "read", "/Order/EligibilityCheck"], "expect": "read" },
  "rule explain":      { "intent": "explain a rule (rendered condition + structure)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "explain", "/Order/EligibilityCheck"], "expect": "read" },
  "rule deps":         { "intent": "list a rule's forward dependencies (the fields it references + iteration)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "deps", "/Order/DeliveryNotBeforeOrder"], "expect": "read" },
  "rule format":       { "intent": "render a rule's condition in canonical DSL text", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "format", "/Order/EligibilityCheck"], "expect": "read" },
  "rule eval":         { "intent": "evaluate whether one rule fires on a filled instance", "model": "order-ruled.dm.json", "doc": { "fields": { "Order": { "CustomerName": "Acme", "Quantity": "5", "OrderDate": "2026-01-01", "DeliveryDate": "2026-01-10" } } }, "command": ["-m", "<model.json>", "rule", "eval", "/Order/DeliveryNotBeforeOrder", "--instance", "<doc.json>"], "expect": "read" },
  "rule modify":       { "intent": "preview lowering a rule's severity", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "modify", "/Order/EligibilityCheck", "--severity", "WARNING", "--dry-run"], "expect": "preview" },
  "rule remove":       { "intent": "preview removing a rule", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "remove", "/Order/EligibilityCheck", "--dry-run"], "expect": "preview" },
  "rule rename":       { "intent": "preview renaming a rule (collision-refused)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "rule", "rename", "/Order/EligibilityCheck", "--to", "EligibilityGate", "--dry-run"], "expect": "preview" },

  "computation read":  { "intent": "read a computation's calculation back as DSL", "model": "subscription-computed.dm.json", "command": ["-m", "<model.json>", "computation", "read", "/Subscription/Billing/EffectiveFeeComp"], "expect": "read" },
  "computation explain": { "intent": "explain a computation (rendered calc + structure)", "model": "subscription-computed.dm.json", "command": ["-m", "<model.json>", "computation", "explain", "/Subscription/Billing/EffectiveFeeComp"], "expect": "read" },
  "computation format": { "intent": "render a computation's calculation in canonical DSL", "model": "subscription-computed.dm.json", "command": ["-m", "<model.json>", "computation", "format", "/Subscription/Billing/EffectiveFeeComp"], "expect": "read" },
  "computation remove": { "intent": "preview removing a computation", "model": "subscription-computed.dm.json", "command": ["-m", "<model.json>", "computation", "remove", "/Subscription/Billing/EffectiveFeeComp", "--dry-run"], "expect": "preview" },

  "field read":        { "intent": "read a field's kind + config into data", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "field", "read", "/Order/Quantity"], "expect": "read" },
  "field rename":      { "intent": "preview renaming a field (references rewritten)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "field", "rename", "/Order/Quantity", "--to", "OrderQuantity", "--dry-run"], "expect": "preview" },
  "field move":        { "intent": "preview moving a field to another group", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "field", "move", "/Order/Quantity", "--to", "/Order/Items", "--dry-run"], "expect": "preview" },
  "field remove":      { "intent": "preview removing a field (safe-delete gate)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "field", "remove", "/Order/Quantity", "--dry-run"], "expect": "preview" },

  "group add":         { "intent": "preview adding a sub-group", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "add", "--parent", "/Order", "--name", "Notes", "--dry-run"], "expect": "preview" },
  "group modify":      { "intent": "preview making a group repeatable", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "modify", "/Order/ShippingAddress", "--repeatable", "5", "--dry-run"], "expect": "preview" },
  "group multiselect": { "intent": "preview a multi-select group template", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "multiselect", "--parent", "/Order", "--name", "Conditions", "--field", "Condition", "--values", "NEW,USED,REFURBISHED", "--max-rows", "3", "--dry-run"], "expect": "preview" },
  "group attachment":  { "intent": "preview a file-attachment group template", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "attachment", "--parent", "/Order", "--name", "Invoice", "--dry-run"], "expect": "preview" },
  "group read":        { "intent": "read a group's structure into data", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "read", "/Order/Items"], "expect": "read" },
  "group rename":      { "intent": "preview renaming a group", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "rename", "/Order/Items", "--to", "LineItems", "--dry-run"], "expect": "preview" },
  "group move":        { "intent": "preview moving a group under another parent", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "move", "/Order/Items", "--to", "/Order/ShippingAddress", "--dry-run"], "expect": "preview" },
  "group remove":      { "intent": "preview removing a group (cascade gate)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "remove", "/Order/Items", "--dry-run"], "expect": "preview" },
  "group extract":     { "intent": "preview extracting fields into a sub-model typedef", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "group", "extract", "/Order/ShippingAddress", "--reference", "addressLib", "--dry-run"], "expect": "preview" },

  "typedef add":       { "intent": "preview declaring a field type-definition", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "typedef", "add", "--id", "PostalCodeType", "--kind", "STRING", "--dry-run"], "expect": "preview" },
  "typedef modify":    { "intent": "preview changing a type definition's config in one place (typed fields inherit it)", "model": "typedefs.dm.json", "command": ["-m", "<model.json>", "typedef", "modify", "--id", "PostalCodeType", "--kind", "STRING", "--dry-run"], "expect": "preview" },
  "typedef read":      { "intent": "list the declared type-definition ids into data", "model": "typedefs.dm.json", "command": ["-m", "<model.json>", "typedef", "read"], "expect": "read" },
  "typedef remove":    { "intent": "preview removing a type definition", "model": "typedefs.dm.json", "command": ["-m", "<model.json>", "typedef", "remove", "PostalCodeType", "--dry-run"], "expect": "preview" },
  "typedef rename":    { "intent": "preview renaming a type definition (using fields repointed)", "model": "typedefs.dm.json", "command": ["-m", "<model.json>", "typedef", "rename", "PostalCodeType", "--to", "ZipCodeType", "--dry-run"], "expect": "preview" },
  "typedef extract":   { "intent": "preview extracting fields into a new type definition", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "typedef", "extract", "--from", "/Order/ShippingAddress/Street,/Order/ShippingAddress/City", "--id", "AddressType", "--dry-run"], "expect": "preview" },
  "typedef inline":    { "intent": "preview inlining a type definition back into its using fields", "model": "typedefs.dm.json", "command": ["-m", "<model.json>", "typedef", "inline", "PostalCodeType", "--dry-run"], "expect": "preview" },
  "typedef import":    { "intent": "preview importing another model's type definitions (merged by id)", "model": "order-ruled.dm.json", "siblings": ["catalogtypes.dm.json"], "command": ["-m", "<model.json>", "typedef", "import", "--reference", "catalogtypes", "--dry-run"], "expect": "preview" },
  "typedef unimport":  { "intent": "preview removing a type-definition import (the inverse of `typedef import`)", "model": "order-imports-types.dm.json", "siblings": ["catalogtypes.dm.json"], "command": ["-m", "<model.json>", "typedef", "unimport", "--reference", "catalogtypes", "--dry-run"], "expect": "preview" },

  "include read":      { "intent": "list the declared model includes into data", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "read"], "expect": "read" },
  "include add":       { "intent": "preview mounting a sub-model as an include", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "add", "--alias", "catalog2", "--name", "Catalog2", "--parent", "/Storefront", "--reference", "catalog", "--dry-run"], "expect": "preview" },
  "include set-reference": { "intent": "preview repointing an include at a different referenced model in place", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "set-reference", "catalog", "--to", "catalog", "--dry-run"], "expect": "preview" },
  "include rename":    { "intent": "preview renaming an include alias (header + mounts) in step", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "rename", "catalog", "--to", "catalog2", "--dry-run"], "expect": "preview" },
  "include remove":    { "intent": "preview removing a model include", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "remove", "catalog", "--dry-run"], "expect": "preview" },
  "include inline":    { "intent": "preview inlining an included sub-model in place", "model": "multifile/app/storefront.dm.json", "siblings": ["multifile/lib/catalog.dm.json"], "command": ["-m", "<model.json>", "include", "inline", "catalog", "--dry-run"], "expect": "preview" },

  "config read":       { "intent": "read the model config (locale, decimals, comment)", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "config", "read"], "expect": "read" },
  "config modify":     { "intent": "preview setting the model comment", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "config", "modify", "--comment", "Order intake model", "--dry-run"], "expect": "preview" },

  "workspace list":    { "intent": "index a directory of models — ids, sub/supertypes, and includes/type-def imports resolved to their files", "siblings": ["multifile/app/storefront.dm.json", "multifile/lib/catalog.dm.json"], "command": ["workspace", "list", "<workspace-dir>"], "expect": "read" },
  "workspace graph":   { "intent": "graph a directory's model-inheritance hierarchy (subtype→supertype)", "siblings": ["inheritance/Product_Base.dm.json", "inheritance/ProductSingle.dm.json", "inheritance/ProductBundle.dm.json"], "command": ["workspace", "graph", "<workspace-dir>"], "expect": "read" },
  "workspace check":    { "intent": "statically check every model in a directory (the project gate); exit 1 if any is invalid", "siblings": ["order.dm.json", "person.dm.json"], "command": ["workspace", "check", "<workspace-dir>"], "expect": "read" },
  "workspace roles":   { "intent": "lint a workspace's access-control roles — resolve each model's `roles` annotation against the discovered auth/roles.yaml; flag any undefined role (a gate even the SME doesn't apply), exit 1 on an ERROR", "rolesWorkspace": { "models": ["roles/Storefront_DM.json", "roles/Catalog_DM.json"], "roles": "roles/storefront-roles.yaml" }, "command": ["workspace", "roles", "<roles-workspace>"], "expect": "read" },

  "where-used":        { "intent": "list the rules/computations referencing a field", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "where-used", "/Order/Quantity"], "expect": "read" },
  "meta":              { "intent": "read an element's descriptions + annotations", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "meta", "/Order/Quantity"], "expect": "read" },
  "export":            { "intent": "render the model card artifact to stdout", "model": "order-ruled.dm.json", "command": ["-m", "<model.json>", "export", "card"], "expect": "raw" },
  "patterns":          { "intent": "list the validation idioms an agent can scaffold a correct rule from", "command": ["patterns"], "expect": "raw" }
}
