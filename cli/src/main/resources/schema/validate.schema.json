{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mbackschat/a12-rulekit/schema/validate.schema.json",
  "title": "ValidationResult",
  "description": "Output of `rulekit validate` (and `check`) — the real-kernel verdict plus any diagnostics (kernel consistency problems and rulekit lint). `valid` is false iff any diagnostic is an ERROR.",
  "type": "object",
  "required": ["valid", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "valid": { "type": "boolean" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["severity", "source", "summary", "where"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "description": "ERROR | WARNING | INFO" },
        "source": { "type": "string", "description": "KERNEL (consistency check) | LINT (rulekit advisory)" },
        "code": { "type": "string", "description": "the MVK_* / RK_* code; absent for some kernel problems" },
        "summary": { "type": "string", "description": "human-readable description" },
        "where": {
          "type": "object",
          "description": "where the problem sits",
          "additionalProperties": false,
          "properties": {
            "rule": { "type": "string", "description": "the rule's full name (\"\" for a not-yet-named candidate)" },
            "operator": { "type": "string", "description": "the offending operator, when known" },
            "span": { "type": "array", "items": { "type": "integer" }, "description": "[start, end] char offsets into the condition text, when known" }
          }
        },
        "fix": { "type": "string", "description": "a suggested remedy, when the diagnostic can offer one" },
        "explain": { "type": "string", "description": "the underlying rule/semantics, when helpful" }
      }
    }
  }
}
