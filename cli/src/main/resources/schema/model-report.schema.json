{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mbackschat/a12-dmkits/schema/model-report.schema.json",
  "title": "ModelReport",
  "description": "The `data` payload of `dmtool -m <model> model report` (MODEL-REVIEW-SPEC §4). The default branch is the stable whole-model comprehension bundle. `--tree` selects the alternative flat, document-ordered node projection `{root,summary,nodes[]}`; hierarchy is recoverable from path/parent/depth and only `--text` draws it.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "ordinary comprehension report",
      "required": ["identity", "structure", "polarity", "unreferenced", "rules", "computations"]
    },
    {
      "title": "tree projection",
      "required": ["root", "summary", "nodes"]
    }
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modelType", "modelVersion", "locales"],
      "properties": {
        "id": { "type": "string", "description": "the model's header id" },
        "modelType": { "type": "string", "description": "the kernel model type (e.g. document)" },
        "modelVersion": { "type": "string", "description": "the document-model format version" },
        "locales": { "type": "array", "items": { "type": "string" }, "description": "the declared display locales" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "groups"],
      "description": "the lean structure outline (full per-kind config is available via `field read`)",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string", "description": "the field's full path" },
              "kind": { "type": "string", "description": "the value kind (NUMBER, STRING, DATE, ENUMERATION, …)" }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "repeatable", "maxRepetitions"],
            "properties": {
              "path": { "type": "string", "description": "the group's full path" },
              "repeatable": { "type": "boolean", "description": "whether the group repeats" },
              "maxRepetitions": { "type": "integer", "description": "max rows (1 when non-repeatable)" }
            }
          }
        }
      }
    },
    "polarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firesOn", "note"],
      "description": "why every rule fires — the model-level constant (an A12 rule's condition is TRUE on the VIOLATION), carried once",
      "properties": {
        "firesOn": { "type": "string", "description": "what a rule condition fires on — always 'violation'" },
        "note": { "type": "string", "description": "the polarity explanation" }
      }
    },
    "unreferenced": {
      "type": "array",
      "items": { "type": "string" },
      "description": "the fields no rule or computation reads — the dead-field audit headline (the full field→referrers map is `model usage`)"
    },
    "rules": {
      "type": "array",
      "description": "the glossed rule catalog — every validation rule in plain language",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "scope", "explained", "canonicalText", "severity", "code", "messages"],
        "properties": {
          "rule": { "type": "string", "description": "the rule's full name" },
          "scope": { "type": "string", "description": "the group the rule is scoped to (its grouping key)" },
          "explained": { "type": "boolean", "description": "false when rulekit reads the condition as Opaque" },
          "gloss": { "type": "string", "description": "the tool-computed plain-language one-liner (absent when Opaque)" },
          "canonicalText": { "type": "string", "description": "the kernel-canonical condition text" },
          "severity": { "type": "string", "description": "ERROR / WARNING / INFO" },
          "code": { "type": "string", "description": "the rule's error code" },
          "errorField": { "type": "string", "description": "the field the diagnostic attaches to (when set)" },
          "reason": { "type": "string", "description": "the construct rulekit could not model — present only when explained is false" },
          "messages": {
            "type": "array",
            "description": "the verbatim stored messages (the modeller's own text)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locale", "text"],
              "properties": {
                "locale": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "computations": {
      "type": "array",
      "description": "the glossed computation catalog — every computed field in plain language, with its preconditions (commonPrecondition + per-alternative), in parity with `computation read`",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["computation", "scope", "explained", "errorCodesToSuppress", "messages"],
        "properties": {
          "computation": { "type": "string", "description": "the computation's full name" },
          "scope": { "type": "string", "description": "the group the computation is scoped to" },
          "explained": { "type": "boolean", "description": "false when rulekit reads the operation as Opaque" },
          "computedField": { "type": "string", "description": "the field this computation fills (when explained)" },
          "gloss": { "type": "string", "description": "the tool-computed plain-language one-liner (absent when Opaque)" },
          "canonicalText": { "type": "string", "description": "the kernel-canonical text (present when Opaque)" },
          "reason": { "type": "string", "description": "the construct rulekit could not model — present only when explained is false" },
          "commonPrecondition": { "type": "string", "description": "the precondition gating the WHOLE computation, when set — the DSL text (same shape as `computation read`)" },
          "roundingMode": { "type": "string", "enum": ["RoundUp", "RoundDown"], "description": "how the computed value is rounded (to a whole number, in the mode's direction), when not Exact — absent means Exact, as A12 stores it (same shape as `computation read`); the computation element's own member, so it is present whether or not the formula is explained" },
          "errorCodesToSuppress": {
            "type": "array",
            "items": { "type": "string" },
            "description": "the exact A12 IComputation.errorCodesToSuppress list, retained even when the formula is Opaque; empty only when the computation declares none"
          },
          "alternatives": {
            "type": "array",
            "description": "the (precondition?, operation, toleranceRangeOp?) formulae — same shape as `computation read`; present when explained",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": {
                "precondition": { "type": "string", "description": "this alternative's precondition, when it has one (absent for a single unconditional operation)" },
                "operation": { "type": "string", "description": "the calculated-value operation, as DSL text" },
                "toleranceRangeOp": {
                  "type": "string",
                  "enum": ["DiffersWithToleranceRange1", "DiffersWithToleranceRange2", "DiffersWithToleranceRange5", "DiffersWithToleranceRange10"],
                  "description": "this alternative's implicit-validation tolerance band, when set"
                }
              }
            }
          },
          "messages": {
            "type": "array",
            "description": "the verbatim stored self-validation messages",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locale", "text"],
              "properties": {
                "locale": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "root": {
      "type": "string",
      "description": "the selected subtree root (`/` is the synthetic model root)"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "groups", "rules", "computations", "maxDepth", "repeatableGroups"],
      "properties": {
        "fields": { "type": "integer" },
        "groups": { "type": "integer" },
        "rules": { "type": "integer" },
        "computations": { "type": "integer" },
        "maxDepth": { "type": "integer" },
        "repeatableGroups": { "type": "integer" }
      }
    },
    "nodes": {
      "type": "array",
      "description": "flat node records in deterministic mixed document order; path/parent/depth recover hierarchy",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "parent", "depth", "kind"],
        "properties": {
          "path": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "depth": { "type": "integer" },
          "kind": { "type": "string", "enum": ["model", "group", "field"] },
          "type": { "type": "string", "description": "field value kind" },
          "scale": { "type": "integer" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "minLength": { "type": "integer" },
          "maxLength": { "type": "integer" },
          "pattern": { "type": "string" },
          "computed": { "type": "boolean" },
          "values": { "type": "array", "items": { "type": "string" } },
          "valueCount": { "type": "integer", "description": "complete enum-domain size" },
          "truncated": { "type": "boolean", "description": "true when values is only a preview; use `--include enum` for all values" },
          "categories": {
            "type": "object",
            "description": "enum category name to its distinct values",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          },
          "repeatable": { "type": "boolean" },
          "maxReps": { "type": "integer" },
          "origin": { "type": "string", "description": "included model id, present only on an include-mount group boundary" },
          "typeRef": { "type": "string", "description": "the field's authored named type before effective-type inlining" },
          "descriptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "internal": { "type": "object", "additionalProperties": { "type": "string" } },
              "external": { "type": "object", "additionalProperties": { "type": "string" } },
              "helper": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "annotations": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "rules": {
            "type": "array",
            "description": "rules anchored once at their error entity (model-level rules at the selected root)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "dsl"],
              "properties": {
                "name": { "type": "string" },
                "dsl": { "type": "string" }
              }
            }
          },
          "computation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "dsl"],
            "properties": {
              "name": { "type": "string" },
              "dsl": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "root": "/Order",
      "summary": {
        "fields": 1,
        "groups": 1,
        "rules": 0,
        "computations": 0,
        "maxDepth": 1,
        "repeatableGroups": 0
      },
      "nodes": [
        {
          "path": "/Order",
          "parent": null,
          "depth": 0,
          "kind": "group",
          "repeatable": false,
          "maxReps": 1
        },
        {
          "path": "/Order/Channel",
          "parent": "/Order",
          "depth": 1,
          "kind": "field",
          "type": "ENUMERATION",
          "computed": false,
          "values": ["WEB", "STORE", "PHONE", "PARTNER", "APP"],
          "valueCount": 10,
          "truncated": true
        }
      ]
    },
    {
      "root": "/Order",
      "summary": {
        "fields": 2,
        "groups": 1,
        "rules": 1,
        "computations": 1,
        "maxDepth": 1,
        "repeatableGroups": 0
      },
      "nodes": [
        {
          "path": "/Order",
          "parent": null,
          "depth": 0,
          "kind": "group",
          "repeatable": false,
          "maxReps": 1
        },
        {
          "path": "/Order/ContactEmail",
          "parent": "/Order",
          "depth": 1,
          "kind": "field",
          "type": "STRING",
          "computed": false,
          "typeRef": "EmailType",
          "descriptions": {
            "internal": { "en_US": "Customer contact address" },
            "helper": { "en_US": "Use the order contact." }
          },
          "annotations": { "classification": "pii" },
          "rules": [
            {
              "name": "/Order/EmailRequired",
              "dsl": "FieldNotFilled(ContactEmail)"
            }
          ]
        },
        {
          "path": "/Order/Total",
          "parent": "/Order",
          "depth": 1,
          "kind": "field",
          "type": "NUMBER",
          "scale": 0,
          "computed": true,
          "computation": {
            "name": "/Order/TotalComputation",
            "dsl": "[Quantity]"
          }
        }
      ]
    }
  ]
}
