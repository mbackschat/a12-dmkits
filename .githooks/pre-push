#!/bin/sh
# Regenerate public README source statistics before commits leave the clone. The generator reads the worktree,
# so this hook first proves that every pushed non-deletion ref is the clean checked-out HEAD. A hook cannot add
# resulting README edits to commits Git already selected, so regeneration still aborts when it changes one.
set -eu

ROOT=$(git rev-parse --show-toplevel)
HEAD_COMMIT=$(git rev-parse --verify HEAD^{commit})
HAS_UPDATE=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    ''|*[!0]*) ;;
    *) continue ;; # deletion: no local tree leaves the clone
  esac
  LOCAL_COMMIT=$(git rev-parse --verify "$local_sha^{commit}" 2>/dev/null) || {
    echo "source statistics: pushed ref is not a commit: $local_ref ($local_sha)" >&2
    exit 1
  }
  if [ "$LOCAL_COMMIT" != "$HEAD_COMMIT" ]; then
    echo "source statistics: refusing to measure $local_ref at $LOCAL_COMMIT from the HEAD worktree $HEAD_COMMIT" >&2
    echo "check out the ref and push it separately so its public README describes its own sources" >&2
    exit 1
  fi
  HAS_UPDATE=1
done

[ "$HAS_UPDATE" -eq 1 ] || exit 0

DIRTY=$(git status --porcelain=v1 --untracked-files=all)
if [ -n "$DIRTY" ]; then
  echo "source statistics: refusing to measure a dirty worktree; commit or remove these changes first:" >&2
  printf '%s\n' "$DIRTY" >&2
  exit 1
fi

if command -v tokei >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  exec "$ROOT/scripts/update-code-statistics.sh" --fail-on-update --allow-missing-lean
fi

echo "warning: tokei/jq unavailable; checking source statistics without regenerating" >&2
exec "$ROOT/scripts/update-code-statistics.sh" --check --allow-missing-lean
