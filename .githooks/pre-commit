#!/usr/bin/env bash
# Refuses five kinds of commit, each block below carrying its own reason:
#   - one that stages build output or log files;
#   - one whose staged files can drift a CI-gated doc, unless the doc guards have run green since;
#   - one that leaves a derived doc regenerated but unstaged;
#   - ANY commit, unless the repository-wide leak lane has run green since the newest staged change;
#   - ANY commit, when any test run written since the newest staged change recorded a failure.
# It also WARNS, without refusing, about a staged source file past its soft line limit (SOURCE SIZE below).
#
# BUILD OUTPUT. .gitignore does NOT cover this: it is consulted only for UNTRACKED paths, so `git add -f` walks
# straight past it and, once a path is tracked, the ignore rule is never consulted again. That is exactly how 72
# `build/*-red.log` files entered this repository across ~20 commits on 2026-07-26/27 and published 591 copies
# of an absolute home path. This hook is the early, local half of the defence; the authoritative half is
# `TrackedOutputGuardTest`, which runs in CI where a hook cannot be assumed.
#
# Wire it once per clone:  git config core.hooksPath .githooks   (scripts/doctor.sh checks that you did)
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------------------------------------
# READING AN mtime PORTABLY, AND REFUSING WHEN WE CANNOT. `stat` speaks two incompatible dialects, and the
# first version of the doc-guard check tried the BSD one and fell back to the GNU one — which does not work,
# because the wrong dialect does not fail CLEANLY. GNU's `stat -f %m F` reads `%m` as a FILE: it prints F's
# FILESYSTEM block on stdout and exits 1, so `stat -f %m F || stat -c %Y F` returned that block CONCATENATED
# with the real number. Every `[ "$t" -gt … ]` then died as a non-integer — and because such a test sits on
# the LEFT of a `&&`, `set -e` exempts it — so every mtime silently read as 0, `0 -lt 0` was false, and that
# entire check NEVER FIRED on any GNU-coreutils machine, i.e. on Linux and on CI. It worked on macOS, which is
# why only CI saw it (2026-08-22). Hence: probe the dialect ONCE, validate that every reading is an integer,
# compare with `if` rather than `&&`, and REFUSE if a reading is unusable. A check that cannot measure must not
# wave a commit through. Locked in both dialects plus the answers-neither case by
# scripts/selftest-precommit-doc-guards.sh, which is CI-run via `:deliveryGuardTest`.
is_epoch() { case "${1:-}" in '' | *[!0-9]*) return 1;; *) return 0;; esac; }
if is_epoch "$(stat -c %Y -- . 2>/dev/null || true)"; then
  stat_dialect=gnu
elif is_epoch "$(stat -f %m . 2>/dev/null || true)"; then
  stat_dialect=bsd
else
  printf '\npre-commit: cannot read file mtimes — neither `stat -c %%Y` nor `stat -f %%m` returned a number,\n' >&2
  printf 'so the guard-evidence checks cannot run and are refusing rather than passing blind.\n' >&2
  printf 'Teach the hook this platform, or bypass once with `git commit --no-verify` (CI still gates).\n' >&2
  exit 1
fi
mtime_of() { # epoch seconds of $1, or the empty string
  case "$stat_dialect" in
    gnu) stat -c %Y -- "$1" 2>/dev/null || true;;
    bsd) stat -f %m "$1" 2>/dev/null || true;;
  esac
}
# Every helper below returns non-zero when a reading is unusable; callers must turn that into an exit, since
# they run in a command substitution where an `exit` would only leave the subshell.
epoch_or_refuse() {
  t="$(mtime_of "$1")"
  if ! is_epoch "$t"; then
    printf '\npre-commit: could not read the mtime of %s (%s dialect); refusing rather than guessing.\n' \
      "$1" "$stat_dialect" >&2
    return 1
  fi
  printf '%s' "$t"
}
newest_path() { # the newest of the whitespace-separated paths in $1, skipping absent ones; empty if none
  newest=0
  newest_file=""
  for f in $1; do
    [ -e "$f" ] || continue
    t="$(epoch_or_refuse "$f")" || return 1
    if [ "$t" -gt "$newest" ]; then newest=$t; newest_file=$f; fi
  done
  printf '%s' "$newest_file"
}
newest_mtime() { # the mtime of newest_path $1; 0 if none
  p="$(newest_path "$1")" || return 1
  if [ -z "$p" ]; then printf 0; else epoch_or_refuse "$p"; fi
}
# What a lane's result directory $1 says about a change whose newest file has mtime $2: `stale` when no result
# file was written since, `red` when one written since records a failure, `green` otherwise.
#
# RED IS NOT EVIDENCE. Freshness alone was the whole test until 2026-09-24, so a lane that ran red after the
# change satisfied the check exactly as a green run did. Only files written since the change are read for
# failures: result files persist, so a red file from an earlier run of a class that has since been re-run
# green in a newer file must not refuse forever. Strictly-older is stale; mtimes are second-granular, so a tie
# means "the guard ran in the same second as the edit" and counts as fresh, since a guard run cannot
# realistically predate the change it validates by less than a second, and CI is the authoritative half.
lane_state() {
  newest_xml=0
  red=""
  if [ -d "$1" ]; then
    for x in "$1"/TEST-*.xml; do
      [ -e "$x" ] || continue
      t="$(epoch_or_refuse "$x")" || return 1
      if [ "$t" -gt "$newest_xml" ]; then newest_xml=$t; fi
      if [ "$t" -ge "$2" ] && grep -Eq '<testsuite [^>]*(failures|errors)="[1-9]' "$x"; then red=1; fi
    done
  fi
  if [ "$newest_xml" -lt "$2" ]; then
    printf stale
  elif [ -n "$red" ]; then
    printf red
  else
    printf green
  fi
}
report_evidence() { # $1 = the stale lanes, $2 = the red ones
  if [ -n "$1" ]; then
    printf '\nStale (or absent) evidence:\n' >&2
    printf '  %s\n' $1 >&2
  fi
  if [ -n "$2" ]; then
    printf '\nEvidence written since the change that records a FAILURE (read the failing class there):\n' >&2
    printf '  %s\n' $2 >&2
  fi
}

refused=""

# ---------------------------------------------------------------------------------------------------------
# Refuse a commit whose staged files can drift a CI-GATED DOC, unless the doc guards have run green since.
#
# WHY THIS IS A HOOK AND NOT A RULE. The guards exist and work; the gap is that `-Pfast` deliberately drops
# them (51s + 51s is a real inner-loop tax), so the inner loop cannot see this class at all. That was written
# down in CLAUDE.md as a trigger table — and then broken three times in one day, the third time hours after the
# note warning about it, because a prose rule fires only when someone re-reads it. Same reasoning as the
# tracked-output half of this hook: local and early here, authoritative in CI.
#
# THE THREE MEASURED DRIFT PATHS, all invisible to a filtered or -Pfast run:
#   a schema property DESCRIPTION      -> examples/cli-discover.md pins whole `schema result` blocks verbatim
#   a new RkCode                       -> the same file pins the diagnostics COUNT
#   a KERNEL-FINDINGS entry            -> docs/OPERATOR-INDEX.md is DERIVED and regenerated, never authored
#   an operator-catalog edit           -> cli-discover pins the operator count; cli-tour pins operator prose
#
# The trigger set is deliberately BROAD. Over-triggering costs one ~1-minute run; under-triggering ships red,
# which is what happened. Staleness is decided on mtime against the guards' own result XMLs — the same
# technique the native-image gate uses — so the hook runs no build and keeps no state of its own.
# ANY markdown, anywhere — not a curated list of doc directories. The first version of this check listed
# `docs/`, `examples/`, `skill/` and a root-anchored `README.md`, and promptly let a commit touching `CLAUDE.md`
# and `scripts/README.md` through with the root guard's results deleted: a false green in the very check written
# to stop false greens. `CommandReferencesResolveTest` reads CLAUDE.md and every command-bearing markdown in the
# tree, so the honest trigger is the file type, not its folder.
doc_triggers="$(printf '%s\n' "$staged" | grep -E \
  '\.md$|^cli/src/main/resources/schema/|RkCode\.java$|^rulekit/src/main/resources/catalog/|^skill/' \
  || true)"
if [ -n "$doc_triggers" ]; then
  newest_trigger="$(newest_mtime "$doc_triggers")" || exit 1
  stale_lanes=""
  red_lanes=""
  # Every doc-driven lane. referentGuardTest and staleGapGuardTest were added 2026-09-03 after a
  # quoted-title ratchet in the first went red on commit 033fe3ef6, which this check had passed. Root
  # :docGuardTest already dependsOn all the cli lanes, so the gap is not the task graph: `--rerun` does
  # NOT propagate to dependencies, so a session that reruns some of the named tasks leaves the others
  # UP-TO-DATE — genuinely unrun against the change — and the freshness check inspected only the
  # directories it knew about, so nothing noticed until a LATER edit finally tripped the ratchet.
  #
  # semanticsMapGuardTest was added 2026-09-04, and its absence is why that comment used to read "all four
  # doc-driven lanes" while being short by one. It declares SEMANTICS-MAP, KERNEL-FINDINGS, KERNEL-SEMANTICS
  # and INTERPRETER-GAPS as inputs, and a SEMANTICS-MAP edit citing a lock class outside the configured lock
  # trees left :cli:test red for three commits without this check noticing. Derive the list when you touch
  # it: the doc-driven lanes are the test tasks whose declared inputs include a docs/*.md file.
  for d in build/test-results/docGuardTest cli/build/test-results/docGuardTest \
           cli/build/test-results/referentGuardTest cli/build/test-results/staleGapGuardTest \
           cli/build/test-results/semanticsMapGuardTest; do
    state="$(lane_state "$d" "$newest_trigger")" || exit 1
    case "$state" in
      stale) stale_lanes="$stale_lanes $d";;
      red) red_lanes="$red_lanes $d";;
      green) ;;
    esac
  done
  if [ -n "$stale_lanes$red_lanes" ]; then
    printf '\nStaged changes can drift a CI-gated doc, and the doc guards have not run since, or ran red:\n\n' >&2
    printf '  %s\n' $doc_triggers >&2
    report_evidence "$stale_lanes" "$red_lanes"
    cat >&2 <<'DOCMESSAGE'

Run them — WITHOUT -Pfast, which skips them by design:

  ./build.sh --console=plain :docGuardTest --rerun :cli:docGuardTest --rerun \
    :cli:referentGuardTest --rerun :cli:staleGapGuardTest --rerun :cli:semanticsMapGuardTest --rerun

Every `--rerun` is deliberate, and `--rerun` is PER-TASK, so one trailing flag would attach only to the
last task named. This check reads result-file mtimes, and Gradle does not refresh the outputs of a task it
finds UP-TO-DATE — which is the normal outcome for the many guards that do not declare your edited file as
an input. Without the flags the command usually leaves this check refusing exactly as before.

Then commit again. If a demo drifted, the failing guard prints the exact regeneration command.

`git commit --no-verify` bypasses this; CI will still fail, which is deliberate — a local bypass must not be
able to make the repository wrong.
DOCMESSAGE
    refused=1
  fi
fi

# ---------------------------------------------------------------------------------------------------------
# Refuse a commit that leaves a DERIVED doc regenerated in the working tree but unstaged.
#
# The doc guards read the WORKING TREE, so once `:cli:dumpOperatorIndex` has regenerated the index they run
# green against a file this commit does not carry, and the check above passes. CI checks out the commit, with
# the KERNEL-FINDINGS edit and the old index, and fails. Measured 2026-09-26: a commit landed that way and was
# caught only by reading `git status` afterwards. Only a derived file is refused, because it is never authored:
# an unstaged change to one is always a regeneration the commit forgot, never a deliberate partial commit.
derived_unstaged="$(git diff --name-only -- docs/OPERATOR-INDEX.md)"
if [ -n "$derived_unstaged" ]; then
  printf '\nA derived doc was regenerated but not staged, so the guards validated a file this commit lacks:\n\n' >&2
  printf '  %s\n' $derived_unstaged >&2
  printf '\nStage it with `git add %s` and commit again.\n' "$derived_unstaged" >&2
  refused=1
fi

# ---------------------------------------------------------------------------------------------------------
# Refuse EVERY commit unless the repository-wide leak lane has run green since the newest staged change.
#
# `leakGuardTest` is always-run and repo-wide, so it sits behind `-Pfast` (TESTING-SPEC "Test tiers") and CI is
# its only other runner — which runs only on a push, and pushes here are rare by design. The lane is no longer
# only a leak scan: every guard whose denominator is a whole source tree rides it, so an ordinary kit change can
# turn it red. BuilderCheckerDivergenceGuardTest did: 58 commits landed between 8d7c55ee0 (2026-09-22), the
# first to cite one of the six codes it then flagged, and the fix ec9326df0 (2026-09-24), each on a green
# -Pfast run.
#
# The trigger is EVERY staged file rather than a curated set, for the reason the lane gives for being
# always-run: each class derives its own denominator, and the file that turns one red is the one nobody
# listed. The price was measured before choosing that: 13s wall for a warm run (2026-09-24). A deleted file has
# no mtime to compare, so a deletion-only commit is left to CI.
leak_lane=build/test-results/leakGuardTest
newest_staged="$(newest_mtime "$staged")" || exit 1
leak_state="$(lane_state "$leak_lane" "$newest_staged")" || exit 1
if [ "$leak_state" != green ]; then
  printf '\nThe repository-wide leak lane has no green result since the newest staged change.\n' >&2
  case "$leak_state" in
    stale) report_evidence "$leak_lane" "";;
    red) report_evidence "" "$leak_lane";;
  esac
  cat >&2 <<'LEAKMESSAGE'

Run it — WITHOUT -Pfast, which skips it by design:

  ./build.sh --console=plain :leakGuardTest

It always runs in full, so it needs no rerun flag. When the doc guards were refused above as well, add it to
their command: one Gradle start instead of two. A failure is fixed in the change, never bypassed.

`git commit --no-verify` bypasses this; CI will still fail, which is deliberate.
LEAKMESSAGE
  refused=1
fi

# ---------------------------------------------------------------------------------------------------------
# Refuse EVERY commit when ANY test run written since the newest staged change recorded a failure.
#
# The blocks above ask whether NAMED lanes have run green since the change; none asks whether the runs that
# did happen passed. a878443c8 (2026-09-24) landed with `:catalogProseReviewGuardTest` red: the guard had run
# against the staged change and failed, but the command chain that ran it did not gate the commit on its
# status, and no block here read that lane. A result file written after the change that records a failure is
# the one piece of evidence that is never ambiguous, so this reads every lane, root and module, rather than a
# curated list that the next unlisted lane would walk past.
#
# Only files strictly newer than the newest staged file are read. That keeps an old red from refusing
# forever: a class re-run green rewrites its own file, and an edit made after a red run moves the comparison
# past it. It also sets the limit, stated rather than hidden: a red run followed by a later, unrelated edit
# is not seen here, and the lane blocks above and CI stay the net for it.
newest_staged_file="$(newest_path "$staged")" || exit 1
result_roots=""
for d in build/test-results */build/test-results; do
  if [ -d "$d" ]; then result_roots="$result_roots $d"; fi
done
red_results=""
if [ -n "$newest_staged_file" ] && [ -n "$result_roots" ]; then
  fresh_results="$(find $result_roots -name 'TEST-*.xml' -newer "$newest_staged_file")" || exit 1
  if [ -n "$fresh_results" ]; then
    # grep answers 1 for "no file matched", which is the green case; anything above that is a read it could
    # not make, and a check that cannot read must refuse rather than pass blind.
    set +e
    red_results="$(grep -lE '<testsuite [^>]*(failures|errors)="[1-9]' $fresh_results)"
    grep_status=$?
    set -e
    if [ "$grep_status" -gt 1 ]; then
      printf '\npre-commit: could not read the test results written since the change; refusing.\n' >&2
      exit 1
    fi
  fi
fi
if [ -n "$red_results" ]; then
  printf '\nA test run written since the newest staged change recorded a FAILURE:\n\n' >&2
  for x in $red_results; do
    lane="$(printf '%s' "$x" | sed -e 's#^build/test-results/\([^/]*\)/.*#:\1#' \
      -e 's#^\([^/]*\)/build/test-results/\([^/]*\)/.*#:\1:\2#')"
    printf '  %s  (lane %s)\n' "$x" "$lane" >&2
  done
  cat >&2 <<'REDMESSAGE'

Read the failing class there, fix it in the change, and re-run that lane: a green run rewrites the file.

A deliberately red run leaves the same evidence — the red half of red/green, or a mutant that was killed —
and is cleared the same way, by the green run that follows it.

`git commit --no-verify` bypasses this; CI will still fail on a real red, which is deliberate.
REDMESSAGE
  refused=1
fi

# ---------------------------------------------------------------------------------------------------------
offenders="$(printf '%s\n' "$staged" | grep -E '(^|/)build/|\.log$' || true)"
if [ -n "$offenders" ]; then
  printf '\nRefusing to commit build output or log files:\n\n' >&2
  printf '  %s\n' $offenders >&2
  cat >&2 <<'MESSAGE'

These are ignored by .gitignore, so they can only have been staged with `git add -f`.
Build output is reproducible and logs carry absolute machine paths; neither belongs in history.

  Unstage:  git restore --staged <path>
  Evidence you want to keep: quote the failing assertion in the owning doc, not the raw log
                             (docs/TESTING-SPEC.md, "Red-step evidence belongs in the owning doc")

If you are certain, `git commit --no-verify` bypasses this hook — TrackedOutputGuardTest will still fail
the build, which is deliberate: a local bypass must not be able to make the repository wrong.
MESSAGE
  refused=1
fi

# ---------------------------------------------------------------------------------------------------------
# SOURCE SIZE. A warning, never a refusal: it names each staged source past its SOFT line limit while splitting
# it is still a choice. The hard limit is SourceFileSizeLimitGuardTest's, in the leak lane this hook already
# requires, and both read scripts/source-size-limits.json. Skipped where the launcher is absent (the hook's
# selftests run it in fabricated repositories) or Node cannot start, since a warning must not block a commit.
sources="$(printf '%s\n' "$staged" | grep -E '\.(java|kt|ts)$' || true)"
if [ -n "$sources" ] && [ -x scripts/run-typescript.sh ]; then
  # shellcheck disable=SC2086 # one staged path per word; tracked source paths carry no whitespace
  scripts/run-typescript.sh source-size-warning scripts/typescript/source-size-warning.ts $sources \
    || printf 'pre-commit: the source-size warning could not run; the hard limit is still enforced by leakGuardTest\n' >&2
fi

if [ -n "$refused" ]; then exit 1; fi
