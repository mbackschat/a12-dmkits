#!/usr/bin/env bash
# Refuses to stage build output or log files.
#
# .gitignore does NOT cover this: it is consulted only for UNTRACKED paths, so `git add -f` walks straight
# past it and, once a path is tracked, the ignore rule is never consulted again. That is exactly how 72
# `build/*-red.log` files entered this repository across ~20 commits on 2026-07-26/27 and published 591 copies
# of an absolute home path. This hook is the early, local half of the defence; the authoritative half is
# `TrackedOutputGuardTest`, which runs in CI where a hook cannot be assumed.
#
# Wire it once per clone:  git config core.hooksPath .githooks   (scripts/doctor.sh checks that you did)
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------------------------------------
# Refuse a commit whose staged files can drift a CI-GATED DOC, unless the doc guards have run since.
#
# WHY THIS IS A HOOK AND NOT A RULE. The guards exist and work; the gap is that `-Pfast` deliberately drops
# them (51s + 51s is a real inner-loop tax), so the inner loop cannot see this class at all. That was written
# down in CLAUDE.md as a trigger table — and then broken three times in one day, the third time hours after the
# note warning about it, because a prose rule fires only when someone re-reads it. Same reasoning as the
# tracked-output half of this hook: local and early here, authoritative in CI.
#
# THE THREE MEASURED DRIFT PATHS, all invisible to a filtered or -Pfast run:
#   a schema property DESCRIPTION      -> examples/cli-discover.md pins whole `schema result` blocks verbatim
#   a new RkCode                       -> the same file pins the diagnostics COUNT
#   a KERNEL-FINDINGS entry            -> docs/OPERATOR-INDEX.md is DERIVED and regenerated, never authored
#   an operator-catalog edit           -> cli-discover pins the operator count; cli-tour pins operator prose
#
# The trigger set is deliberately BROAD. Over-triggering costs one ~1-minute run; under-triggering ships red,
# which is what happened. Staleness is decided on mtime against the guards' own result XMLs — the same
# technique the native-image gate uses — so the hook runs no build and keeps no state of its own.
# ANY markdown, anywhere — not a curated list of doc directories. The first version of this check listed
# `docs/`, `examples/`, `skill/` and a root-anchored `README.md`, and promptly let a commit touching `CLAUDE.md`
# and `scripts/README.md` through with the root guard's results deleted: a false green in the very check written
# to stop false greens. `CommandReferencesResolveTest` reads CLAUDE.md and every command-bearing markdown in the
# tree, so the honest trigger is the file type, not its folder.
doc_triggers="$(printf '%s\n' "$staged" | grep -E \
  '\.md$|^cli/src/main/resources/schema/|RkCode\.java$|^rulekit/src/main/resources/catalog/|^skill/' \
  || true)"
if [ -n "$doc_triggers" ]; then
  # READING AN mtime PORTABLY, AND REFUSING WHEN WE CANNOT. `stat` speaks two incompatible dialects, and the
  # first version of this check tried the BSD one and fell back to the GNU one — which does not work, because
  # the wrong dialect does not fail CLEANLY. GNU's `stat -f %m F` reads `%m` as a FILE: it prints F's
  # FILESYSTEM block on stdout and exits 1, so `stat -f %m F || stat -c %Y F` returned that block
  # CONCATENATED with the real number. Every `[ "$t" -gt … ]` then died as a non-integer — and because such a
  # test sits on the LEFT of a `&&`, `set -e` exempts it — so every mtime silently read as 0, `0 -lt 0` was
  # false, and this entire check NEVER FIRED on any GNU-coreutils machine, i.e. on Linux and on CI. It worked
  # on macOS, which is why only CI saw it (2026-08-22). Hence: probe the dialect ONCE, validate that every
  # reading is an integer, compare with `if` rather than `&&`, and REFUSE if a reading is unusable. A check
  # that cannot measure must not wave a commit through. Locked in both dialects plus the answers-neither case
  # by scripts/selftest-precommit-doc-guards.sh, which is CI-run via `:deliveryGuardTest`.
  is_epoch() { case "${1:-}" in '' | *[!0-9]*) return 1;; *) return 0;; esac; }
  if is_epoch "$(stat -c %Y -- . 2>/dev/null || true)"; then
    stat_dialect=gnu
  elif is_epoch "$(stat -f %m . 2>/dev/null || true)"; then
    stat_dialect=bsd
  else
    printf '\npre-commit: cannot read file mtimes — neither `stat -c %%Y` nor `stat -f %%m` returned a number,\n' >&2
    printf 'so the doc-guard staleness check cannot run and is refusing rather than passing blind.\n' >&2
    printf 'Teach the hook this platform, or bypass once with `git commit --no-verify` (CI still gates).\n' >&2
    exit 1
  fi
  mtime_of() { # epoch seconds of $1, or the empty string
    case "$stat_dialect" in
      gnu) stat -c %Y -- "$1" 2>/dev/null || true;;
      bsd) stat -f %m "$1" 2>/dev/null || true;;
    esac
  }
  # Returns non-zero when the reading is unusable; callers must turn that into an exit, since this runs in a
  # command substitution where an `exit` would only leave the subshell.
  epoch_or_refuse() {
    t="$(mtime_of "$1")"
    if ! is_epoch "$t"; then
      printf '\npre-commit: could not read the mtime of %s (%s dialect); refusing rather than guessing.\n' \
        "$1" "$stat_dialect" >&2
      return 1
    fi
    printf '%s' "$t"
  }

  newest_trigger=0
  for f in $doc_triggers; do
    [ -e "$f" ] || continue
    t="$(epoch_or_refuse "$f")" || exit 1
    if [ "$t" -gt "$newest_trigger" ]; then newest_trigger=$t; fi
  done
  oldest_evidence=""
  # Every doc-driven lane. referentGuardTest and staleGapGuardTest were added 2026-09-03 after a
  # quoted-title ratchet in the first went red on commit 033fe3ef6, which this check had passed. Root
  # :docGuardTest already dependsOn all the cli lanes, so the gap is not the task graph: `--rerun` does
  # NOT propagate to dependencies, so a session that reruns some of the named tasks leaves the others
  # UP-TO-DATE — genuinely unrun against the change — and the freshness check inspected only the
  # directories it knew about, so nothing noticed until a LATER edit finally tripped the ratchet.
  #
  # semanticsMapGuardTest was added 2026-09-04, and its absence is why that comment used to read "all four
  # doc-driven lanes" while being short by one. It declares SEMANTICS-MAP, KERNEL-FINDINGS, KERNEL-SEMANTICS
  # and INTERPRETER-GAPS as inputs, and a SEMANTICS-MAP edit citing a lock class outside the configured lock
  # trees left :cli:test red for three commits without this check noticing. Derive the list when you touch
  # it: the doc-driven lanes are the test tasks whose declared inputs include a docs/*.md file.
  for d in build/test-results/docGuardTest cli/build/test-results/docGuardTest \
           cli/build/test-results/referentGuardTest cli/build/test-results/staleGapGuardTest \
           cli/build/test-results/semanticsMapGuardTest; do
    newest_xml=0
    if [ -d "$d" ]; then
      for x in "$d"/TEST-*.xml; do
        [ -e "$x" ] || continue
        t="$(epoch_or_refuse "$x")" || exit 1
        if [ "$t" -gt "$newest_xml" ]; then newest_xml=$t; fi
      done
    fi
    # Strictly-older is stale. mtimes are second-granular, so a tie means "the guard ran in the same
    # second as the edit" — treated as fresh, since a ~1-minute guard run cannot realistically predate
    # the change it validates by less than a second, and CI is the authoritative half regardless.
    if [ "$newest_xml" -lt "$newest_trigger" ]; then oldest_evidence="$oldest_evidence $d"; fi
  done
  if [ -n "$oldest_evidence" ]; then
    printf '\nStaged changes can drift a CI-gated doc, and the doc guards have not run since:\n\n' >&2
    printf '  %s\n' $doc_triggers >&2
    printf '\nStale (or absent) evidence:\n' >&2
    printf '  %s\n' $oldest_evidence >&2
    cat >&2 <<'DOCMESSAGE'

Run them — WITHOUT -Pfast, which skips them by design:

  ./build.sh --console=plain :docGuardTest --rerun :cli:docGuardTest --rerun \
    :cli:referentGuardTest --rerun :cli:staleGapGuardTest --rerun :cli:semanticsMapGuardTest --rerun

Every `--rerun` is deliberate, and `--rerun` is PER-TASK, so one trailing flag would attach only to the
last task named. This check reads result-file mtimes, and Gradle does not refresh the outputs of a task it
finds UP-TO-DATE — which is the normal outcome for the many guards that do not declare your edited file as
an input. Without the flags the command usually leaves this check refusing exactly as before.

Then commit again. If a demo drifted, the failing guard prints the exact regeneration command.

`git commit --no-verify` bypasses this; CI will still fail, which is deliberate — a local bypass must not be
able to make the repository wrong.
DOCMESSAGE
    exit 1
  fi
fi

offenders="$(printf '%s\n' "$staged" | grep -E '(^|/)build/|\.log$' || true)"
[ -z "$offenders" ] && exit 0

printf '\nRefusing to commit build output or log files:\n\n' >&2
printf '  %s\n' $offenders >&2
cat >&2 <<'MESSAGE'

These are ignored by .gitignore, so they can only have been staged with `git add -f`.
Build output is reproducible and logs carry absolute machine paths; neither belongs in history.

  Unstage:  git restore --staged <path>
  Evidence you want to keep: quote the failing assertion in the owning doc, not the raw log
                             (docs/TESTING-SPEC.md, "Red-step evidence belongs in the owning doc")

If you are certain, `git commit --no-verify` bypasses this hook — TrackedOutputGuardTest will still fail
the build, which is deliberate: a local bypass must not be able to make the repository wrong.
MESSAGE
exit 1
