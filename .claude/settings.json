{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-long-run-antipatterns.sh\"",
            "timeout": 10,
            "statusMessage": "checking long-run anti-patterns"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/perf-trend.sh)",
      "Bash(./scripts/perf-trend.sh *)",
      "Bash(./scripts/perf-anchor.sh)",
      "Bash(./scripts/perf-anchor.sh show)",
      "Bash(./scripts/perf-history.sh)",
      "Bash(./scripts/perf-history.sh *)",
      "Bash(./scripts/check-release-gaps.sh)",
      "Bash(./scripts/doctor.sh)"
    ]
  }
}
