#!/bin/sh
# dmtool — stable launcher shim for the dmtool CLI.
#
# Docs, showboat demos, and any script call `dmtool <target> <op> …`; this shim
# resolves that to the fastest CLI implementation present on the box, so the call
# site never names a packaging artifact. Same stable-interface / swappable-impl
# split as the packaging decision (ARCHITECTURE.md §5d, CLI-SPEC §11 phases B1/B2): jlink/JVM
# is the dev default, the native image is an opt-in startup-win upgrade — the doc
# text is identical either way.
#
# Resolution order (first hit wins):
#   1. $DMTOOL_CLI                          — explicit override (path to a binary/launcher)
#   2. native image, IF RK_NATIVE=1         — ~37 ms start, opt-in startup-win upgrade (CLI-SPEC §11 phase B2)
#   3. installDist launcher                 — ~600 ms JVM, the dev DEFAULT (always current)
#   4. (none) → exit 2 with a build hint
#
# Native is opt-in (RK_NATIVE=1), never auto-preferred: a stale native artifact
# would otherwise silently shadow freshly-built code. The JVM launcher, rebuilt
# by `:cli:installDist`, is the safe default; opt into native only when you've
# rebuilt it and want the startup win.
set -eu
ROOT="$(CDPATH='' cd "$(dirname "$0")/.." && pwd)"

# Validate the Java the installDist launcher will pick BEFORE delegating, and fail with a recovery hint.
# The generated Gradle start script trusts $JAVA_HOME blindly, so a stale versioned Homebrew Cellar path
# (routine after `brew upgrade openjdk`) dies inside that script before dmtool can diagnose anything. The
# native image needs no Java at all, so this gate only applies to the JVM route.
# Supported development JDK: 21 (the build's pin). A newer JDK still runs, with a caveat: on 26+ Jackson's
# reflective deserialization of a kernel final field emits a mutation WARNING on stderr — stdout stays
# clean JSON, so the machine contract holds, but the announced future block would not.
# Sourced for `a12_classify_java`, which single-sources the JDK probe this gate and the source-preparation
# script both need. REQUIRED, not best-effort: a missing helper would otherwise turn the gate off silently,
# and a gate that disappears when its dependency does is worse than no gate, because the shim keeps claiming
# to have checked. It ships in the same tree as this shim, so absence is a broken checkout — say so.
if [ ! -r "$ROOT/scripts/gradle-environment.sh" ]; then
  printf 'dmtool: cannot read %s — this checkout is incomplete.\n' "$ROOT/scripts/gradle-environment.sh" >&2
  exit 2
fi
# shellcheck source=scripts/gradle-environment.sh
. "$ROOT/scripts/gradle-environment.sh"

require_supported_java() {
  hint="set JAVA_HOME to a JDK 21 installation, or unset it to use the system default.
  On macOS:  export JAVA_HOME=\$(/usr/libexec/java_home -v 21)"
  a12_classify_java "${JAVA_HOME:-}"
  # Every branch REFUSES rather than guessing. Two of them were once silent successes: a FAILING
  # `java -version` left the version empty and the gate returned 0 (the launcher then died with the child's
  # status, no dmtool diagnostic, no hint), and an UNPARSEABLE banner did the same, so dmtool exited 0 with
  # empty stdout — the worst outcome for an agent, which reads that as "ran fine, nothing to report".
  case "$a12_java_kind" in
    no-home-binary)
      printf 'dmtool: JAVA_HOME points at a directory with no java executable:\n  %s\n%s\n' \
        "$JAVA_HOME" "$hint" >&2
      printf '  (a versioned Homebrew Cellar path breaks on every brew upgrade openjdk)\n' >&2
      return 2 ;;
    no-java)
      printf 'dmtool: no java found on PATH and JAVA_HOME is unset.\n%s\n' "$hint" >&2
      return 2 ;;
    failed)
      printf 'dmtool: %s -version failed (exit %s) — this Java is not usable:\n%s\n%s\n' \
        "$a12_java_bin" "$a12_java_status" "$a12_java_banner" "$hint" >&2
      return 2 ;;
    unreadable)
      printf 'dmtool: cannot read a Java version from %s -version — refusing rather than guessing:\n%s\n%s\n' \
        "$a12_java_bin" "$a12_java_banner" "$hint" >&2
      return 2 ;;
    too-old)
      printf 'dmtool: Java %s is too old — the supported development JDK is 21 (a NEWER JDK also runs).\n%s\n' \
        "$a12_java_major" "$hint" >&2
      return 2 ;;
    ok) return 0 ;;
    # A gate with no default arm FAILS OPEN: an unrecognised kind would fall through to success and the shim
    # would keep claiming it had checked. Name the kind instead of guessing what it means.
    *)
      printf 'dmtool: the JDK classifier returned an unrecognised verdict %s — refusing rather than '\
'guessing.\n%s\n' "$a12_java_kind" "$hint" >&2
      return 2 ;;
  esac
}

# Whether $1 will need a JDK: a Gradle/jlink start script is a shell script that resolves `java` through
# JAVA_HOME/JAVACMD, while a native image is a self-contained binary. Deciding by CONTENT rather than by path
# fixes a bypass: the gate used to apply only to a path ending `/install/dmtool/bin/dmtool`, so an explicit
# $DMTOOL_CLI pointing at any other JVM launcher (a distTar unpack, a jlink image) skipped it entirely — while
# the comment beside it claimed only the JVM launcher depends on a JDK, which was the intent, not the behaviour.
needs_jdk() {
  head -c 2 "$1" 2>/dev/null | grep -q '#!' || return 1
  grep -qE 'JAVA_HOME|JAVACMD' "$1" 2>/dev/null
}

run_candidate() {
  candidate="$1"
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    # Only a JVM launcher depends on a JDK; a native binary is self-contained. Detected by content (needs_jdk),
    # so an explicit $DMTOOL_CLI pointing at a JVM launcher is gated too.
    if needs_jdk "$candidate"; then
      require_supported_java || exit 2
    fi
    shift
    exec "$candidate" "$@"
  fi
}

run_candidate "${DMTOOL_CLI:-}" "$@"
if [ "${RK_NATIVE:-}" = "1" ]; then
  run_candidate "$ROOT/cli/build/native/nativeCompile/dmtool" "$@" # GraalVM Gradle plugin output
  run_candidate "$ROOT/cli/build/native/nativeCompile/dmtool.exe" "$@" # Windows output under Git Bash
  run_candidate "$ROOT/build/native-spike/dmtool-cli-res" "$@" # CLI-SPEC §11 phase B2 spike output
fi
run_candidate "$ROOT/cli/build/install/dmtool/bin/dmtool" "$@" # installDist launcher — the default

cat >&2 <<'EOF'
dmtool: no dmtool CLI found.
  Build it once:   ./gradlew :cli:installDist
  Or set DMTOOL_CLI=/path/to/cli, or build the native image (CLI-SPEC §11 phase B2).
EOF
exit 2
