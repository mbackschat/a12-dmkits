#!/usr/bin/env bash
# dmtool — stable launcher shim for the dmtool CLI.
#
# Docs, showboat demos, and any script call `dmtool <target> <op> …`; this shim
# resolves that to the fastest CLI implementation present on the box, so the call
# site never names a packaging artifact. Same stable-interface / swappable-impl
# split as the packaging decision (ARCHITECTURE.md §5.1, CLI-SPEC §B1/§B2): jlink/JVM
# is the dev default, the native image is an opt-in startup-win upgrade — the doc
# text is identical either way.
#
# Resolution order (first hit wins):
#   1. $DMTOOL_CLI                          — explicit override (path to a binary/launcher)
#   2. native image, IF RK_NATIVE=1         — ~37 ms start, opt-in startup-win upgrade (CLI-SPEC §B2)
#   3. installDist launcher                 — ~600 ms JVM, the dev DEFAULT (always current)
#   4. (none) → exit 2 with a build hint
#
# Native is opt-in (RK_NATIVE=1), never auto-preferred: a stale native artifact
# would otherwise silently shadow freshly-built code. The JVM launcher, rebuilt
# by `:cli:installDist`, is the safe default; opt into native only when you've
# rebuilt it and want the startup win.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

candidates=("${DMTOOL_CLI:-}")
if [[ "${RK_NATIVE:-}" == "1" ]]; then
  candidates+=(
    "$ROOT/cli/build/native/dmtool"             # conventional native output (future :cli native task)
    "$ROOT/build/native-spike/dmtool-cli-res"   # the CLI-SPEC §B2 spike's resource-bundled binary
  )
fi
candidates+=("$ROOT/cli/build/install/dmtool/bin/dmtool")  # installDist launcher — the default
for c in "${candidates[@]}"; do
  if [[ -n "$c" && -x "$c" ]]; then exec "$c" "$@"; fi
done

cat >&2 <<'EOF'
dmtool: no dmtool CLI found.
  Build it once:   ./gradlew :cli:installDist
  Or set DMTOOL_CLI=/path/to/cli, or build the native image (CLI-SPEC §B2).
EOF
exit 2
