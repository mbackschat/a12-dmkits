# direnv config — on `cd` into this repo, auto-applies the public-repos-only Gradle home + JDK 21, so a
# bare `./gradlew` is never contaminated by the machine's `~/.gradle/init.d/repositories.gradle` (which
# injects a private, credentialed registry into every project). Requires direnv (`brew install direnv`)
# + a one-time `direnv allow`. No direnv? Use `./build.sh <gradle args>` instead, or set the two exports by
# hand (README "Build & test"). Root cause: docs/BUILD-ENVIRONMENT.md.
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$(cd .. && pwd)/.gradle-isolated}"
if [[ -x /usr/libexec/java_home ]]; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 21)"
fi
