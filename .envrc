# direnv config — on `cd` into this repo, auto-applies the public-repos-only Gradle home + JDK 21, so a
# bare `./gradlew` is never contaminated by the machine's `~/.gradle/init.d/repositories.gradle` (which
# injects a private, credentialed registry into every project). Requires direnv (`brew install direnv`)
# + a one-time `direnv allow`. No direnv? Use `./build.sh <gradle args>` instead, or set the two exports by
# hand (README "Build & test"). Root cause: docs/BUILD-ENVIRONMENT.md.
# Both values come from the shared helper rather than being re-derived here. This file decides JAVA_HOME for
# every `cd` into the repository, so a copy of the pin here is a second site deciding one policy — exactly the
# drift that once made a stale JAVA_HOME read as a source-provenance verdict. `a12_gradle_user_home` is also
# worktree-aware, which the hand-rolled `cd ..` was not.
source scripts/gradle-environment.sh
watch_file scripts/gradle-environment.sh
export GRADLE_USER_HOME="$(a12_gradle_user_home "$PWD")"
pinned_jdk21="$(a12_pinned_jdk21_home 2>/dev/null || true)"
[[ -z "$pinned_jdk21" ]] || export JAVA_HOME="$pinned_jdk21"
unset pinned_jdk21
