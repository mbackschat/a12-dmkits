# locmetry policy for a12-dmkits — `locmetry --schema config` is the contract, `locmetry explain <path>`
# shows which entry decided a file. The production / verification / tooling split mirrors the one
# scripts/update-code-statistics.sh already publishes in the READMEs; keep the two in step.
version = 1

[categories]
implementation = "The shipped product: the dmkits, adapter, CLI, interpreter, consistency checker and their facades"
showcase = "The browser playground published with the interpreter release"
release-site = "Static pages of the public interpreter release mirror"
plugin = "The Claude Code and Codex plugin bundles and the agent skill they ship"
generated = "Committed output a task regenerates, kept for packaging or API-compatibility checks"
build-tooling = "Gradle build logic"
tooling = "Maintainer scripts, probes, eval harness and hooks: maintained, but neither shipped nor a check on what ships"
ci = "GitHub Actions workflows"
agent-config = "Agent harness settings for Claude Code, Codex and AGENTS.md readers"
documentation = "Maintained specs, findings, ledgers and guides"
example = "Showboat walkthroughs and the sample models they own, plus worked consumer examples such as the Node CI gate"
test = "Tests, laws, differentials, fixtures and test utilities"
consumer-test = "External consumer projects that install the packed artifacts and import them by package name"
script-selftest = "Self-tests of the maintainer scripts"
conformance-corpus = "The kernel-verified conformance corpus that every engine replays"
measurement-history = "Recorded benchmark results, read back by the perf-trend tooling"
archived = "Archived proposals and designs kept as history, not authority"

# Overrides win before the built-in conventions and before every rule. They are used only where a convention
# decides the right purpose but too coarse a category (consumer projects contain *.test.* files the
# js-test-file convention would label plain `test`), and to carve a program out of a broader override that
# would otherwise swallow it: entries cannot be negated, so the narrow entry must come first.

[[overrides]]
id = "consistency-ci-gate-example"
match = ["consistency/consumer-tests/node/ci-gate.mjs"]
kind = ["source"]
purpose = "production"
category = "example"
reason = "docs/CONSISTENCY-API.md presents it as a runnable pipeline step (`node ci-gate.mjs <sources>`) and consistency/consumer-tests/node/README.md calls it a worked example with its own test, ci-gate.test.mjs; a program with its own tests is code under test, not test"

[[overrides]]
id = "consistency-parity-corpus-writer"
match = ["consistency/consumer-tests/node/write-parity-corpus.mjs"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Regenerates the three-arm parity corpus from the packed package (consistency/consumer-tests/shared/parity/README.md: generated, never edited by hand); run only by the syncCheckerParityCorpus task, which is a sync task and never a gate"

[[overrides]]
id = "script-selftests"
match = [
  "scripts/selftest-*.sh",
  "scripts/typescript/*.test.ts",
  "interpreter/typescript/scripts/*.test.mjs",
]
kind = ["source"]
purpose = "test"
category = "script-selftest"
reason = "Each selftest-*.sh locks the behaviour of another maintainer script and each .test.ts / .test.mjs imports its sibling script (scripts/README.md names the pairs); an override because builtin:js-test-file would label the .test files plain `test`"

[[overrides]]
id = "consistency-consumer-tests"
match = ["consistency/consumer-tests/**"]
kind = ["source", "data"]
purpose = "test"
category = "consumer-test"
reason = "consistency/consumer-tests/README.md: each project packs the npm tarball, installs it and imports it by package name"

[[overrides]]
id = "interpreter-consumer-tests"
match = [
  "interpreter/consumer-tests/browser/scripts/**",
  "interpreter/consumer-tests/browser/tsconfig.scripts.json",
  "interpreter/consumer-tests/typescript/**",
  "interpreter/consumer-tests/kotlin-jvm/src/**",
  "interpreter/consumer-tests/kotlin-js/src/**",
]
kind = ["source", "data"]
purpose = "test"
category = "consumer-test"
reason = "update-code-statistics.sh counts these as Verification; their Gradle build scripts stay build-tooling by convention; tsconfig.scripts.json compiles only scripts/**/*.ts, so it follows them rather than the showcase's tsconfig*.json rule"

# Rules run after the conventions and before build-module inference, so they also correct what an
# inferred Gradle/npm module would claim as production.

[[rules]]
id = "native-image-metadata"
match = ["cli/src/main/resources/META-INF/native-image/**"]
kind = ["data"]
purpose = "production"
category = "generated"
reason = "rulekit-agent is captured from the test suite by scripts/capture-native-config.sh, rulekit-manual by scripts/gen-native-reflect-metadata.sh (NATIVE-IMAGE-GRAALVM.md)"

[[rules]]
id = "api-dumps"
match = ["**/api/*.api", "interpreter/api/*-package-files.txt"]
purpose = "production"
category = "generated"
reason = "Kotlin binary-compatibility dumps and the locked package file lists, regenerated by their tasks"

[[rules]]
id = "regenerated-records"
match = ["interpreter/published-performance.json", "cli/native-capture-stamp.txt"]
purpose = "production"
category = "generated"
reason = "Written by :interpreter:syncInterpreterPerformanceClaims and the native-config capture; never hand-edited"

[[rules]]
id = "consumer-test-text-fixtures"
match = ["consistency/consumer-tests/shared/parity/sources/*.txt"]
kind = ["documentation"]
purpose = "test"
category = "consumer-test"
reason = "Deliberately non-model inputs the parity corpus replays; .txt reads as documentation, so the kind-scoped consistency-consumer-tests override misses them, and no convention competes for the file"

[[rules]]
id = "generated-checker-projections"
match = [
  "consistency/src/commonMain/kotlin/io/github/mbackschat/a12/dm/consistency/syntax/ConditionKeywords.kt",
  "consistency/src/commonMain/kotlin/io/github/mbackschat/a12/dm/consistency/KernelCorrectives.kt",
]
kind = ["source"]
purpose = "production"
category = "generated"
reason = "Both files open with a GENERATED / do-not-edit header: ConditionKeywords.kt comes from catalog/operators.json via :consistency:generateConditionKeywords (verifyConditionKeywords diffs it), KernelCorrectives.kt via :dumpCheckerCorrectives (CheckerCorrectiveProjectionGuardTest re-derives it); a rule takes them from the :consistency Gradle module"

[[rules]]
id = "interpreter-showcase"
match = [
  "interpreter/consumer-tests/browser/src/**",
  "interpreter/consumer-tests/browser/public/**",
  "interpreter/consumer-tests/browser/index.html",
  "interpreter/consumer-tests/browser/package.json",
  "interpreter/consumer-tests/browser/tsconfig*.json",
]
purpose = "production"
category = "showcase"
reason = "update-code-statistics.sh counts the browser showcase as Production"

[[rules]]
id = "interpreter-release-site"
match = ["interpreter/public-release/**"]
kind = ["source"]
purpose = "production"
category = "release-site"
reason = "Pages assembled into the public interpreter release mirror by scripts/assemble-interpreter-release-repo.sh"

[[rules]]
id = "interpreter-typescript-facade"
match = ["interpreter/typescript/src/**", "interpreter/typescript/tsconfig.json"]
purpose = "production"
category = "implementation"
reason = "The published TypeScript facade; no package descriptor sits beside it, so no module inference claims it"

[[rules]]
id = "shared-regex"
match = ["shared-regex/src/**"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Compiled into :interpreter and :consistency as a second commonMain srcDir (interpreter/build.gradle, consistency/build.gradle)"

[[rules]]
id = "kernel-closure-consumer"
match = ["adapter/src/kernelClosureConsumer/**"]
kind = ["source"]
purpose = "test"
category = "consumer-test"
reason = "A consumer compiled against the adapter's kernel closure; update-code-statistics.sh counts it as Verification"

[[rules]]
id = "plugin-synced-scripts"
match = [
  "plugin/skills/a12-dmtool/ensure-dmtool.sh",
  "plugin/skills/a12-dmtool/release-assets.sh",
  "plugin-codex/skills/a12-dmtool/ensure-dmtool.sh",
  "plugin-codex/skills/a12-dmtool/release-assets.sh",
]
kind = ["source"]
purpose = "production"
category = "generated"
reason = "Byte-identical copies of scripts/ensure-dmtool.sh and scripts/release-assets.sh, written by scripts/sync-plugin-assets.sh (ASSETS in scripts/typescript/sync-plugin-assets.ts; skill/README.md: copies are generated, never edited); the originals stay tooling"

[[rules]]
id = "plugin-bundles"
match = ["plugin/**", "plugin-codex/**", "skill/**"]
purpose = "production"
category = "plugin"
reason = "Distributed plugin assets, kept in sync by scripts/sync-plugin-assets.sh; skill/ is their canonical source"

[[rules]]
id = "gradle-build-logic"
match = ["gradle/*.gradle", "scripts/*.gradle", "gradle.properties", "gradle/*.properties"]
purpose = "production"
category = "build-tooling"
reason = "Gradle script plugins and init scripts applied by the build; the build-script convention only knows build/settings files"

[[rules]]
id = "maintainer-tooling"
match = [
  "scripts/**",
  "probe/**",
  "eval/**",
  "bin/**",
  "build.sh",
  ".envrc",
  ".githooks/**",
  ".claude/hooks/**",
  "interpreter/typescript/scripts/**",
]
kind = ["source", "data"]
purpose = "production"
category = "tooling"
reason = "update-code-statistics.sh's Tooling section: build scripts, generators and the eval harness"

[[rules]]
id = "ci-workflows"
match = [".github/**"]
purpose = "production"
category = "ci"
reason = "GitHub Actions workflows and their configuration"

[[rules]]
id = "agent-config"
match = [".claude/**", ".codex/**", ".agents/**"]
purpose = "production"
category = "agent-config"
reason = "Harness settings and pointer skills; CLAUDE.md names .claude/skills as canonical with pointers in .agents/skills"

[[rules]]
id = "examples"
match = ["examples/**"]
purpose = "production"
category = "example"
reason = "CLAUDE.md: the showboat demos own examples/models and are published with the release mirror"

[[rules]]
id = "conformance-corpus"
match = ["corpus/**"]
purpose = "test"
category = "conformance-corpus"
reason = "corpus/README.md: kernel-verified cases that the interpreter and other engines replay"

[[rules]]
id = "perf-results"
match = ["perf-results/**"]
purpose = "other"
category = "measurement-history"
reason = "Recorded measurements, not code; counted so their growth stays visible"

[[rules]]
id = "archived-docs"
match = ["docs/archived/**"]
purpose = "other"
category = "archived"
reason = "CLAUDE.md treats archived proposals as history, not authority"

[[rules]]
id = "documentation"
match = ["**/*.md"]
kind = ["documentation"]
purpose = "production"
category = "documentation"
reason = "Maintained Markdown; module trees and the root carry their own READMEs and agent instructions"

# A mapping only counts a file the embedded counter does not recognize; it never assigns a purpose.

[[languages.mappings]]
id = "direnv"
match = [".envrc"]
language = "Shell"

[[languages.mappings]]
id = "kotlin-api-dumps"
match = ["**/api/*.api"]
language = "Plain Text"

[[languages.mappings]]
id = "tab-separated-fixtures"
match = ["**/*.tsv"]
language = "Plain Text"

[[languages.mappings]]
id = "service-loader-registrations"
match = ["**/META-INF/services/*"]
language = "Plain Text"
