{
  "name": "a12-consistency-browser-consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build": "pnpm run check && vite build",
    "verify": "pnpm run build && pnpm run build:scripts && node build/browser-scripts/replay.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
