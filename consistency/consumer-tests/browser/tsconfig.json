{
  "compilerOptions": {
    // `.ts` appears in the import specifier because the SHARED case module is imported by both hosts and Node
    // requires the real extension for native type stripping. A bundler-resolution project must be told to
    // accept it, and may then only type-check — which is correct here, since Vite performs the emit.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
