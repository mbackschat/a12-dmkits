# Gradle
.gradle/
.gradle-isolated/
build/

# Kotlin build/daemon cache
.kotlin/

# IDEs
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
bin/*
!bin/dmtool
!bin/README.md
# Eclipse/IDE output inside a module. `bin/*` above carries a slash, so git anchors it to the repository
# root and it never matches `adapter/bin/`; this pattern does, while leaving the tracked root `bin/dmtool`
# alone.
*/bin/

# OS
.DS_Store

# Keep the Gradle wrapper jar tracked
!gradle/wrapper/gradle-wrapper.jar

# agent worktrees (transient, not project content)
.claude/worktrees/

# SME drops a workspace settings file into any folder opened as a workspace
# (opening corpus models in the modeling tools is an intended workflow)
corpus/**/settings.yaml
__pycache__/
