{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "src/service-worker.ts"
  ]
}
