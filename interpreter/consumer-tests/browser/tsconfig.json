{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/service-worker.ts"
  ]
}
