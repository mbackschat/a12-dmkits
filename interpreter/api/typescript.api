# @mbackschat/a12-interpreter public TypeScript ABI

## A12Document
export type A12Document = A12DocumentGroup;

## A12DocumentField
export type A12DocumentField = string | number | boolean | null;

## A12DocumentGroup
export interface A12DocumentGroup {
    readonly [name: string]: A12DocumentField | A12DocumentGroup | readonly A12DocumentGroup[];
}

## A12Result
export type A12Result<T, E extends Error> = {
    readonly ok: true;
    readonly value: T;
} | {
    readonly ok: false;
    readonly error: E;
};

## ComputationOutcome
export type ComputationOutcome = "value" | "cleared" | "errored";

## ComputationReport
export interface ComputationReport {
    readonly results: readonly ComputationResult[];
    readonly unsupported: readonly UnsupportedProgram[];
    readonly fullySupported: boolean;
}

## ComputationResult
export interface ComputationResult {
    readonly pointer: FieldPointer;
    readonly outcome: ComputationOutcome;
    readonly value?: string;
}

## ComputeOptions
export interface ComputeOptions {
    readonly locale?: string;
}

## CustomCondition
export type CustomCondition = (invocation: CustomConditionInvocation) => boolean;

## CustomConditionDocumentView
export interface CustomConditionDocumentView {
    value(pointer: FieldPointer): string | undefined;
    fields(): readonly FieldPointer[];
}

## CustomConditionInvocation
export interface CustomConditionInvocation {
    readonly document: CustomConditionDocumentView;
    readonly relevantEntities?: readonly RelevantEntityPointer[];
    readonly formallyIncorrectEntities: readonly FieldPointer[];
    readonly errorPointer: FieldPointer;
}

## CustomFieldValidationParameters
export interface CustomFieldValidationParameters {
    readonly locale: string;
    readonly minLength?: number;
    readonly maxLength?: number;
    readonly isDisplayValue: boolean;
}

## CustomFieldValidationResult
export type CustomFieldValidationResult = {
    readonly accepted: true;
} | {
    readonly accepted: false;
    readonly errorKey: string;
    readonly message?: string;
};

## CustomFieldValidator
export type CustomFieldValidator = (value: string, parameters: CustomFieldValidationParameters) => CustomFieldValidationResult;

